import { useState } from '@litsx/core';
import { css } from 'lit';
import {
  type GetUserQuery,
  useGetUserQuery,
  useGetUsersQuery,
} from '../graphql';
import { isPresent } from '../utils/isPresent';

export function UserDirectory() {
  const [selectedUserId, setSelectedUserId] = useState('1');
  static styles = css`
    :host {
      display: block;
    }

    .panel {
      display: grid;
      gap: 20px;
      padding: 24px;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.86);
      border: 1px solid rgba(24, 34, 47, 0.08);
      box-shadow: 0 20px 40px rgba(17, 24, 39, 0.06);
    }

    .heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 16px;
    }

    h2 {
      margin: 0;
      font-size: 1.5rem;
    }

    .subtle {
      margin: 4px 0 0;
      color: #5a6a7d;
      line-height: 1.5;
    }

    .grid {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 20px;
    }

    .user-list {
      display: grid;
      gap: 12px;
    }

    button.user-card {
      text-align: left;
      border: 1px solid rgba(24, 34, 47, 0.08);
      border-radius: 18px;
      padding: 16px;
      background: #fff;
      cursor: pointer;
      transition: transform 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
    }

    button.user-card:hover {
      transform: translateY(-1px);
      border-color: rgba(0, 91, 150, 0.2);
      box-shadow: 0 12px 24px rgba(17, 24, 39, 0.06);
    }

    button.user-card.active {
      border-color: #1c79c0;
      background: linear-gradient(180deg, #f4fbff 0%, #ffffff 100%);
    }

    .name {
      margin: 0 0 4px;
      font-size: 1rem;
      font-weight: 700;
    }

    .meta {
      margin: 0;
      color: #5a6a7d;
      line-height: 1.45;
      font-size: 0.92rem;
    }

    .detail {
      display: grid;
      gap: 16px;
      min-height: 100%;
      padding: 18px;
      border-radius: 18px;
      background: #fff;
      border: 1px solid rgba(24, 34, 47, 0.08);
    }

    .detail h3,
    .detail h4 {
      margin: 0;
    }

    .detail p,
    .detail li {
      color: #506071;
      line-height: 1.5;
    }

    .detail ul {
      margin: 0;
      padding-left: 18px;
    }

    .stack {
      display: grid;
      gap: 14px;
    }

    .muted {
      color: #708093;
      font-style: italic;
    }

    @media (max-width: 900px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }
  `;

  const [usersResult] = useGetUsersQuery({
    variables: {
      options: {
        paginate: {
          page: 1,
          limit: 6,
        },
      },
    },
  });
  const [userResult] = useGetUserQuery({
    pause: !selectedUserId,
    variables: {
      id: selectedUserId,
    },
  });

  const users = (usersResult.data?.users?.data ?? []).filter(isPresent);
  const selectedUser: NonNullable<GetUserQuery['user']> | null =
    userResult.data?.user ?? null;

  return (
    <section class="panel">
      <div class="heading">
        <div>
          <h2>User directory</h2>
          <p class="subtle">
            A paginated list plus a detail query with nullable address, company,
            posts, albums, and todos.
          </p>
        </div>
      </div>

      {usersResult.error && <p class="muted">Error: {usersResult.error.message}</p>}

      <div class="grid">
        <div class="user-list">
          {usersResult.fetching && !users.length && <p class="muted">Loading users...</p>}

          {users.map((user) => (
            <button
              key={user.id ?? user.email ?? user.username ?? 'unknown-user'}
              class={'user-card' + (selectedUserId === user.id ? ' active' : '')}
              @click={() => setSelectedUserId(user.id ?? '1')}
            >
              <p class="name">{user.name ?? 'Unknown user'}</p>
              <p class="meta">@{user.username ?? 'unknown'}</p>
              <p class="meta">{user.email ?? 'No email available'}</p>
              <p class="meta">
                {user.company?.name ?? 'Independent'} · {user.address?.city ?? 'Unknown city'}
              </p>
            </button>
          ))}
        </div>

        <article class="detail">
          {userResult.fetching && !selectedUser && <p class="muted">Loading selected user...</p>}

          {selectedUser && (
            <>
              <div>
                <h3>{selectedUser.name ?? 'Unknown user'}</h3>
                <p class="subtle">
                  @{selectedUser.username ?? 'unknown'} · {selectedUser.email ?? 'No email'}
                </p>
              </div>

              <div class="stack">
                <div>
                  <h4>Address</h4>
                  <p>
                    {selectedUser.address?.street ?? 'No street'}
                    {selectedUser.address?.suite ? `, ${selectedUser.address.suite}` : ''}
                    <br />
                    {selectedUser.address?.city ?? 'Unknown city'} ·{' '}
                    {selectedUser.address?.zipcode ?? 'No ZIP'}
                  </p>
                </div>

                <div>
                  <h4>Company</h4>
                  <p>
                    {selectedUser.company?.name ?? 'No company'}
                    <br />
                    {selectedUser.company?.catchPhrase ?? 'No catch phrase'}
                  </p>
                </div>

                <div>
                  <h4>Recent posts</h4>
                  <ul>
                    {(selectedUser.posts?.data ?? []).filter(isPresent).map((post) => (
                      <li key={post.id ?? post.title ?? 'untitled-post'}>
                        {post.title ?? 'Untitled post'}
                      </li>
                    ))}
                  </ul>
                </div>

                <div>
                  <h4>Albums and todos</h4>
                  <p>
                    Albums: {(selectedUser.albums?.data ?? []).filter(isPresent).length}
                    <br />
                    Todos: {(selectedUser.todos?.data ?? []).filter(isPresent).length}
                  </p>
                </div>
              </div>
            </>
          )}
        </article>
      </div>
    </section>
  );
}
