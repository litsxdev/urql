import { getUrqlClient } from '@litsx/urql';
import { PostSearch } from './PostSearch.litsx';
import { UserDirectory } from './UserDirectory.litsx';

export function AppRoot() {
  getUrqlClient();

  static styles = `
    :host {
      display: block;
      min-height: 100vh;
      color: #18222f;
      background:
        radial-gradient(circle at top left, rgba(73, 182, 255, 0.2), transparent 35%),
        radial-gradient(circle at top right, rgba(255, 189, 89, 0.2), transparent 30%),
        linear-gradient(180deg, #f7fbff 0%, #eef4fa 100%);
      font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
    }

    .shell {
      max-width: 1200px;
      margin: 0 auto;
      padding: 32px 20px 64px;
    }

    .hero {
      display: grid;
      gap: 20px;
      padding: 28px;
      border: 1px solid rgba(24, 34, 47, 0.08);
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.82);
      box-shadow: 0 24px 60px rgba(17, 24, 39, 0.08);
      backdrop-filter: blur(14px);
    }

    .eyebrow {
      width: fit-content;
      padding: 6px 10px;
      border-radius: 999px;
      background: #d9efff;
      color: #005b96;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      font-size: clamp(2rem, 4vw, 3.25rem);
      line-height: 1;
    }

    .lede {
      max-width: 72ch;
      margin: 0;
      color: #4c5a6a;
      font-size: 1.02rem;
      line-height: 1.6;
    }

    .status {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      border-radius: 14px;
      font-weight: 600;
      background: #eef4fa;
      color: #1c324a;
    }

    .status.ready {
      background: #def7ea;
      color: #13653f;
    }

    .status::before {
      content: '';
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: currentColor;
      opacity: 0.7;
    }

    .tips {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 14px;
      margin-top: 6px;
    }

    .tip {
      padding: 16px;
      border-radius: 16px;
      background: #fff;
      border: 1px solid rgba(24, 34, 47, 0.08);
    }

    .tip strong {
      display: block;
      margin-bottom: 8px;
      font-size: 0.95rem;
    }

    .tip p {
      margin: 0;
      color: #556272;
      line-height: 1.5;
      font-size: 0.92rem;
    }

    .sections {
      display: grid;
      gap: 28px;
      margin-top: 28px;
    }
  `;

  return (
    <main class="shell">
      <section class="hero">
        <span class="eyebrow">LitSX + urql</span>
        <h1>Neutral GraphQL example with generated hooks</h1>
        <p class="lede">
          This demo targets the public GraphQLZero schema and keeps the same developer
          ergonomics as the library packages: generated query hooks, tuple responses,
          and a plain runtime client without a DOM provider.
        </p>

        <div class="status ready">Client ready for the GraphQLZero demo API</div>

        <div class="tips">
          <div class="tip">
            <strong>Schema snapshot</strong>
            <p>The example keeps a local SDL copy so codegen stays deterministic.</p>
          </div>
          <div class="tip">
            <strong>Generated hooks</strong>
            <p>Queries become typed hooks like <code>useGetUsersQuery()</code>.</p>
          </div>
          <div class="tip">
            <strong>Nullable fields</strong>
            <p>The generated types preserve the current optional-plus-nullable semantics.</p>
          </div>
        </div>
      </section>

      <section class="sections">
        <UserDirectory />
        <PostSearch />
      </section>
    </main>
  );
}
