{
  "name": "@litsx/urql",
  "version": "0.2.0",
  "description": "URQL runtime hooks and client integration for LitSX",
  "author": "LitSX Team",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/litsxdev/urql",
  "bugs": {
    "url": "https://github.com/litsxdev/urql/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/litsxdev/urql.git",
    "directory": "packages/urql"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist .build && tsc --emitDeclarationOnly --outDir dist && tsc --declaration false --declarationMap false --outDir .build && rollup --config rollup.config.mjs && rm -rf .build",
    "dev": "yarn build",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@urql/core": "^6.0.3"
  },
  "peerDependencies": {
    "@litsx/core": "*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "^5.1.6",
    "vitest": "^2.1.9"
  }
}
